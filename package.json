{
  "name": "tasktracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Личный таск-трекер: дашборд, таблица, доска, календарь",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc --noEmit && vite build -c vite.single.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
